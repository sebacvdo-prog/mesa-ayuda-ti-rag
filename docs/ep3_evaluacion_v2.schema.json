      "title": "Ejecucion Id"
    },
    "tipo_ejecucion": {
      "enum": [
        "real",
        "simulada",
        "historica"
      ],
      "title": "Tipo Ejecucion",
      "type": "string"
    },
    "caso": {
      "enum": [
        "ticket_sla",
        "rag_kb",
        "impacto",
        "nota",
        "posponer",
        "sin_procedimiento",
        "reintento",
        "seguridad"
      ],
      "title": "Caso",
      "type": "string"
    },
    "variante": {
      "maximum": 100,
      "minimum": 1,
      "title": "Variante",
      "type": "integer"
    },
    "metrica": {
      "enum": [
        "exactitud_hechos",
        "acierto_documental",
        "cumplimiento_restricciones",
