# =====================================================================
# Copiá este archivo como .env y completá la clave de Groq.
#   cp .env.example .env
# El archivo .env está en .gitignore y nunca debe subirse al repositorio.
# =====================================================================

# --- OBLIGATORIO: chat (Groq, API compatible con OpenAI) -------------
# Se obtiene gratis en https://console.groq.com/keys
LLM_API_KEY=gsk_reemplazar_por_tu_clave_de_groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Agente EP2: misma clave y endpoint, modelo independiente --------
EP2_LLM_MODEL=openai/gpt-oss-20b
EP2_MAX_ITERATIONS=8
EP2_MAX_SECONDS=90
EP2_LLM_TIMEOUT=30

# --- Memoria EP2: retención y límites (sin transcripciones del modelo) ---
EP2_MEMORY_TURNS=6
EP2_MEMORY_FACTS=32
EP2_MEMORY_EVENTS=30
EP2_MEMORY_SESSIONS=200
EP2_MEMORY_DAYS=30
EP2_MEMORY_BYTES=65536
EP2_MEMORY_CONTEXT_CHARS=12000

# --- Embeddings locales (sin API key; modelo descargado la primera vez) ---
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Umbral calibrado con data/evaluacion/dataset.json para este modelo.
# Score de LangChain: 1 - distancia_L2_cuadrada / sqrt(2), no probabilidad.
# Solo afecta Hugging Face; Google conserva 0.72.
HF_SIMILARITY_THRESHOLD=0.471764
# Para recalibrar sin LLM: python -m eval.calibrate_retrieval --offline

# --- Alternativa original: Google AI Studio --------------------------
# Para usar Google, reemplazá las tres variables anteriores por:
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDING_DIM=768
# GOOGLE_API_KEY solo es obligatoria con EMBEDDING_PROVIDER=google.
# Se obtiene en https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=reemplazar_por_tu_clave_de_google
# Sin EMBEDDING_PROVIDER se conserva Google como proveedor predeterminado.
# Al cambiar proveedor/modelo/dimensión, ejecutá python -m src.ingest.
# El índice anterior se conserva como respaldo en storage/; la caché se separa
# por configuración. Nunca mezclar un índice de 768 dimensiones con uno de 384.

# --- OPCIONAL: trazabilidad con LangSmith ----------------------------
# Si estas variables no están, el sistema funciona igual (sin trazas).
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_reemplazar
# LANGCHAIN_PROJECT=mesa-ayuda-ti-rag
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
